# ==============================================================
# ZENISA PERFUMES - CPANEL PRODUCTION CONFIGURATION
# Rename this file to .env on your cPanel server
# ==============================================================

# Server Environment
NODE_ENV=production
API_HOST=0.0.0.0
# Leave PORT empty or set to 3001 if not automatically assigned by cPanel
PORT=3001

# Public URL of your website (used to secure Admin API requests against CSRF)
# E.g. https://yourdomain.com (Do NOT include a trailing slash)
ADMIN_ORIGIN=https://yourdomain.com

# cPanel MySQL Database Credentials
# (Obtained from cPanel -> MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_zenisa
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your_strong_db_password

# Admin Login Credentials
# Current default password: _HHS7wA-JHE3iaG3cEdv4aSs
ADMIN_EMAIL=admin@zenisa.local
ADMIN_PASSWORD_HASH=scrypt:05b9496321de19af366101f45c9e3d3b:52243e53ec1fb4e882a5aca4e3ac6690a2fa5a86c3e011e395e5fc1b900e8ec1485888e245e4c5473ce7d2e03622fdd65db58016d34485b7c0477ef11398fedd
